foreach(_woodshed_target IN LISTS _woodshed_requested)
  get_target_property(_woodshed_type "${_woodshed_target}" TYPE)
  if((_woodshed_type STREQUAL "STATIC_LIBRARY" OR _woodshed_type STREQUAL "SHARED_LIBRARY")
      AND NOT _woodshed_type STREQUAL _woodshed_expected)
    message(FATAL_ERROR "${_woodshed_target} exports ${_woodshed_type}, but the recipe requested ${_woodshed_expected}; select the matching upstream target/options")
  endif()
endforeach()
get_property(_woodshed_imported DIRECTORY PROPERTY IMPORTED_TARGETS)
set(_woodshed_linkage "")
foreach(_woodshed_target IN LISTS _woodshed_imported)
  get_target_property(_woodshed_type "${_woodshed_target}" TYPE)
  if(_woodshed_type STREQUAL "STATIC_LIBRARY")
    set(_woodshed_kind static)
  elseif(_woodshed_type STREQUAL "SHARED_LIBRARY")
    set(_woodshed_kind dynamic)
  else()
    continue()
  endif()
  get_target_property(_woodshed_location "${_woodshed_target}" IMPORTED_LOCATION)
  get_target_property(_woodshed_implib "${_woodshed_target}" IMPORTED_IMPLIB)
  get_target_property(_woodshed_configs "${_woodshed_target}" IMPORTED_CONFIGURATIONS)
  if(_woodshed_location OR _woodshed_implib OR _woodshed_configs)
    string(APPEND _woodshed_linkage "$<TARGET_LINKER_FILE:${_woodshed_target}>\t${_woodshed_kind}\n")
  endif()
endforeach()
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/woodshed-linkage-$<CONFIG>.txt" CONTENT "${_woodshed_linkage}")
